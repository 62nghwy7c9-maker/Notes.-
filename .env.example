# --- Notizen-App: Umgebungsvariablen (nur vom Server gelesen) ---
# Kopiere diese Datei nach `.env` und passe die Werte bei Bedarf an.

# Server-Port (bindet an 127.0.0.1)
PORT=3001

# Ablageort von notes.db + Backups
DATA_DIR=./data

# Optionaler Anthropic-API-Key. Alternativ in den Einstellungen der App
# eingebbar (dort verschlüsselt in der DB gespeichert). Ohne Key läuft die
# App vollständig im manuellen Modus.
ANTHROPIC_API_KEY=

# AES-Schlüssel für den in der DB gespeicherten API-Key.
# Wird beim Erststart generiert, falls leer.
SETTINGS_SECRET=

# Standard-KI-Modell (siehe docs/planning/06-ki-features.md)
AI_MODEL_DEFAULT=claude-sonnet-5
