{
  "name": "notes-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  },
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c blue,magenta \"npm:dev -w @notes/server\" \"npm:dev -w @notes/client\"",
    "build": "npm run build -w @notes/shared -w @notes/server -w @notes/client",
    "start": "tsx --tsconfig server/tsconfig.json server/src/index.ts",
    "db:generate": "drizzle-kit generate --config server/drizzle.config.ts",
    "test": "vitest run",
    "lint": "eslint . && tsc -b"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "concurrently": "^9.1.0",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^2.1.8"
  }
}
